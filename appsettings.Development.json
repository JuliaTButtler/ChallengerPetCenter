{
  "UseInMemoryDatabase": false,
  "ApiSettings": {
    "ApiKey": ""
  },
  "ExternalServices": {
    "HealthCheckUrl": "https://httpbin.org/status/200"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  }
}
