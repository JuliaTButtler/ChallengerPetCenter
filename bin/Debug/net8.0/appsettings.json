{
  "ConnectionStrings": {
    "OracleConnection": "User Id=RM564975;Password=050607;Data Source=oracle.fiap.com.br:1521/ORCL;"
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] ({CorrelationId}/{RequestId}) {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/challenger-pet-center-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] ({CorrelationId}/{RequestId}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "ChallengerPetCenter"
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "HealthChecks": {
    "ExternalServiceUrl": "https://www.google.com"
  },

  "OpenTelemetry": {
    "ServiceName": "ChallengerPetCenter",
    "EnableConsoleExporters": true
  },

  "Jwt": {
    "Key": "ChallengerPetCenter_Dev_Secret_Key_Min32Chars!",
    "Issuer": "ChallengerPetCenter",
    "Audience": "ChallengerPetCenter",
    "ExpirationMinutes": 120
  },

  "AllowedHosts": "*"
}
